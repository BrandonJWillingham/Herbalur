generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  CATEGORY_VIEW
  ADD_TO_CART
  REMOVE_FROM_CART
  BEGIN_CHECKOUT
  PURCHASE
  NEWSLETTER_SIGNUP
}

enum CartStatus {
  ACTIVE
  MERGED
  CHECKED_OUT
  ABANDONED
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  buzzWords   String
  description String
  price       Int
  inventory   Int
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
  details     ProductDetail?
  reviews     Review[]
  ingredients Ingredient[]   @relation("IngredientToProduct")
  events      Event[]
}

model ProductDetail {
  id         String  @id @default(cuid())
  productId  String  @unique
  highlight1 String
  highlight2 String
  highlight3 String
  howToUse   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  imageUrl    String?

  products Product[] @relation("IngredientToProduct")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  productUrl String?
  subject   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id        String  @id @default(cuid())
  firstName String?
  lastName  String?

  email    String? @unique
  phone    String? @unique
  password String?

  createdAt DateTime @default(now())

  carts  Cart[]
  orders Order[]
  events Event[]
}

model Visitor {
  id String @id @default(cuid())

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  sessions Session[]
  events   Event[]
  carts    Cart[]
  orders   Order[]
}

model Session {
  id        String @id @default(cuid())
  visitorId String

  source      String?
  medium      String?
  campaign    String?
  content     String?
  referrer    String?
  landingPage String?

  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  events Event[]
  orders Order[]

  @@index([visitorId])
  @@index([startedAt])
  @@index([campaign])
  @@index([source])
}

model Event {
  id String @id @default(cuid())

  visitorId String
  sessionId String?
  userId    String?
  productId String?

  type EventType

  page     String?
  metadata Json?

  createdAt DateTime @default(now())

  visitor Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([sessionId])
  @@index([userId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model Cart {
  id String @id @default(cuid())

  visitorId String?
  userId    String?

  status CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitor Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  items CartItem[]
  order Order?

  @@index([visitorId])
  @@index([userId])
  @@index([status])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id String @id @default(cuid())

  userId    String?
  visitorId String?
  sessionId String?
  cartId    String? @unique

  customerEmail String?

  status String @default("pending")
  total  Int

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitor Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  cart    Cart?    @relation(fields: [cartId], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([userId])
  @@index([visitorId])
  @@index([sessionId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  name     String
  price    Int
  quantity Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
